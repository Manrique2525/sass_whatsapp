includes:
    - vendor/nunomaduro/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - healthcheck.php

    ignoreErrors:
        # TenantAwareJob es una abstracción real y testeada (tests/Support/{WriteWidgetJob,FailingWidgetJob}.php
        # la consumen y la suite de tests verifica su aislamiento), pero su primer consumidor de producción llega
        # en FASE 26 (procesamiento asíncrono de mensajes). Sin ella, los tests de aislamiento de jobs no existen.
        # TODO(fase-26): eliminar esta exclusión cuando el primer job de producción use el trait.
        -
            identifier: trait.unused
            path: app/Jobs/Concerns/TenantAwareJob.php

        # BelongsToTenant es la infraestructura central del aislamiento (fail-safe de escritura + scope de lectura),
        # probada mediante tests/Support/ScopedWidget.php. Ningún modelo del dominio tenant existe aún (se crean en
        # fases posteriores: conversaciones, flujos, leads...), por eso hoy no hay consumidor en app/.
        # TODO(fase-4+): eliminar esta exclusión cuando el primer modelo del dominio tenant use el trait.
        -
            identifier: trait.unused
            path: app/Domain/Tenants/Traits/BelongsToTenant.php
