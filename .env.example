APP_NAME="WhatsApp SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production containers: LOG_STACK=json (structured JSON to stderr)
# Local development:    LOG_STACK=single (readable file logs)
# Local with rotation:  LOG_STACK=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production recommended: LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ------------------------------------------------------------
# Base de datos (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=whatsapp_saas
DB_USERNAME=saas
DB_PASSWORD=saas_secret

# ------------------------------------------------------------
# Sesiones / cache / cola (Redis)
# ------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------
# Seguridad (FASE 27)
# ------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=
# En producción establecer CORS_ALLOWED_ORIGINS con los dominios
# permitidos separados por coma (ej: https://app.example.com)

# ------------------------------------------------------------
# Tokens (FASE 27 U2)
# ------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=1440
# Tiempo de vida de tokens Sanctum en minutos (1440 = 24h).
# Null = sin expiración (no recomendado en producción).

# ------------------------------------------------------------
# Proxies (FASE 27 U2)
# ------------------------------------------------------------
# TRUSTED_PROXIES=
# IP o CIDR de proxies confiables (separados por coma).
# Null = no confiar en ningún proxy (headers X-Forwarded-* ignorados).
# '*' = confiar en todos (solo detrás de un LB conocido).

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

# ------------------------------------------------------------
# Realtime (Laravel Reverb)
# ------------------------------------------------------------
REVERB_APP_ID=whatsapp-saas
REVERB_APP_KEY=whatsapp-saas-key
REVERB_APP_SECRET=whatsapp-saas-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# ------------------------------------------------------------
# Correo (Mailpit local)
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@whatsapp-saas.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Storage (MinIO local, S3 compatible)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=whatsapp-saas
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000

# ------------------------------------------------------------
# Proveedores externos (se rellenan en fases posteriores)
# ------------------------------------------------------------
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v26.0
# WHATSAPP_CONNECT_TIMEOUT=3
# WHATSAPP_TIMEOUT=10
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_MAX_ATTEMPTS=3

# ------------------------------------------------------------
# IA — Proveedor OpenAI (FASE 16)
# ------------------------------------------------------------
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=15
# AI_MAX_RETRIES=1
# AI_MAX_TOKENS=500

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# IA — Embeddings (FASE 17)
# ------------------------------------------------------------
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=1536
# AI_EMBEDDING_MAX_BATCH=50
# AI_EMBEDDING_TIMEOUT=30
# AI_EMBEDDING_MAX_RETRIES=2

# ------------------------------------------------------------
# Sentry — Observabilidad (FASE 28)
# ------------------------------------------------------------
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT="${APP_ENV}"
# SENTRY_RELEASE=
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_PROFILES_SAMPLE_RATE=

# ------------------------------------------------------------
# Observability — Scheduler Heartbeat (FASE 28 U4)
# ------------------------------------------------------------
# SCHEDULER_HEARTBEAT_MAX_AGE=120

# ------------------------------------------------------------
# Observability — Data Retention (FASE 28 U5)
# ------------------------------------------------------------
# AUDIT_LOG_RETENTION_DAYS=90
# FAILED_JOBS_RETENTION_DAYS=30

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# ------------------------------------------------------------
# Sentry — Frontend Observability (FASE 28 U3)
# ------------------------------------------------------------
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
# VITE_SENTRY_RELEASE=
