<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheResult="false"
>
    <testsuites>
        <testsuite name="PostgresConcurrency">
            <directory>tests/Postgres</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="HANDOFF_U2_PG_TEST" value="1"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_STORE" value="redis"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_HOST" value="postgres"/>
        <server name="DB_PORT" value="5432"/>
        <server name="DB_DATABASE" value="whatsapp_saas_handoff_u2_test"/>
        <server name="DB_USERNAME" value="saas"/>
        <server name="DB_PASSWORD" value="saas_secret"/>
        <server name="REDIS_HOST" value="redis"/>
        <server name="REDIS_PORT" value="6379"/>
        <server name="REDIS_DB" value="14"/>
        <server name="REDIS_CACHE_DB" value="14"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
