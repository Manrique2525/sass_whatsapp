# ------------------------------------------------------------------
# Entorno E2E (Playwright) — FASE 30 / ADR-110
#
# Este es el TEMPLATE versionado. NO contiene secretos reales.
# Para ejecutar E2E localmente se copia a `.env.e2e` (gitignored) y se
# ajustan las credenciales/valores. En CI se generan desde variables editadas.
#
# El guard de seguridad (E2EEnvironmentGuard) ABORTA cualquier operación
# destructiva si APP_ENV != e2e o si la BD no termina en `_e2e_test` o si el
# índice de Redis no es el dedicado. NUNCA operar contra dev/test/prod.
# ------------------------------------------------------------------

APP_NAME="WhatsApp SaaS"
# El guard exige literalmente "e2e". Cambiarlo rompe el entorno a propósito.
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
# La app E2E sirve HTTP en el puerto 8082 (sin nginx, php artisan serve).
APP_URL=http://localhost:8082

# ------------------------------------------------------------------
# Base de datos E2E (misma instancia Postgres que dev, BD DEDICADA)
# ------------------------------------------------------------------
DB_CONNECTION=pgsql
# Host dentro de la red docker compose (container e2e-app).
DB_HOST=postgres
DB_PORT=5432
# Debe terminar en `_e2e_test` (lo exige el guard).
DB_DATABASE=whatsapp_saas_e2e_test
DB_USERNAME=saas
DB_PASSWORD=saas_secret

# ------------------------------------------------------------------
# Sesiones / cache / cola (Redis — índice lógico dedicado 15)
# ------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# HTTP local: cookies sin Secure (si no, la sesión no se persiste en CI host).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# Almacenamiento aislado en disco local (nunca minio compartido).
FILESYSTEM_DISK=local

# U3 usa el worker E2E real para jobs de broadcast y outbound.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=e2e_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Índice lógico dedicado E2E (dev usa 0/1, pgsql tests 14). Exigido por el guard.
REDIS_DB=15
REDIS_CACHE_DB=15

# Reverb E2E: el servidor escucha internamente en reverb-e2e:8080 y el navegador
# conecta al puerto publicado localhost:8083.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=whatsapp-saas-e2e
REVERB_APP_KEY=whatsapp-saas-e2e-key
REVERB_APP_SECRET=whatsapp-saas-e2e-secret
REVERB_HOST=reverb-e2e
REVERB_PORT=8080
REVERB_SCHEME=http

# ------------------------------------------------------------------
# Correo (Mailpit compartido, sin impacto en fixtures de auth)
# ------------------------------------------------------------------
MAIL_MAILER=array

# ------------------------------------------------------------------
# Storage (disco local aislado, sin S3/minio)
# ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

# ------------------------------------------------------------------
# Proveedores externos: VACÍOS en E2E (los fakes deterministas los sustituyen)
# ------------------------------------------------------------------
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_CONNECT_TIMEOUT=3
WHATSAPP_TIMEOUT=10
WHATSAPP_WEBHOOK_MAX_PAYLOAD_BYTES=5242880
WHATSAPP_WEBHOOK_RETENTION_DAYS=7
WHATSAPP_WEBHOOK_FAILED_RETENTION_DAYS=30
WHATSAPP_WEBHOOK_PRUNE_BATCH=100
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MAX_ATTEMPTS=3

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15
AI_MAX_RETRIES=1
AI_MAX_TOKENS=500
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_MAX_BATCH=50
AI_EMBEDDING_TIMEOUT=30
AI_EMBEDDING_MAX_RETRIES=2

# Stripe: vacío en E2E (no se ejercitan llamadas de billing en esta fase).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry: sin DSN (no envía nada durante E2E).
SENTRY_LARAVEL_DSN=

# ------------------------------------------------------------------
# Credenciales de fixtures E2E (seeds)
# ------------------------------------------------------------------
# Contraseña de los usuarios de prueba. Cambiar localmente en `.env.e2e`.
# NO usar una contraseña real/producción.
E2E_TEST_PASSWORD=e2e-password

# ------------------------------------------------------------------
# Frontend Vite (valores del navegador, distintos del host interno Laravel).
# ------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8083
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=whatsapp-saas-e2e-key
VITE_SENTRY_DSN=
