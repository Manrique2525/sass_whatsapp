APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.example.com
APP_IMAGE=whatsapp-saas/app:release
WEB_IMAGE=whatsapp-saas/web:release

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=app.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://app.example.com

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="WhatsApp SaaS"

# Optional integrations remain disabled until their credentials are configured.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15
AI_MAX_RETRIES=1
AI_MAX_TOKENS=500
OPENAI_API_KEY=
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_MAX_BATCH=50
AI_EMBEDDING_TIMEOUT=30
AI_EMBEDDING_MAX_RETRIES=2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend Sentry is optional and must only be set when browser telemetry is approved.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
